# Copy to .env and adjust. Never commit .env.

# Ollama OpenAI-compatible API (default: local only)
ARGUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
ARGUS_LLM_API_KEY=ollama
ARGUS_MODEL=qwen3:4b

# Context window — keep small on 6GB VRAM / 8GB RAM
ARGUS_NUM_CTX=4096

# SQLite path (created automatically)
ARGUS_DB_PATH=data/argus.db

# Single-user V0 identity
ARGUS_USER_ID=addy
ARGUS_USER_ROLE=owner
ARGUS_DEVICE_ID=asus_01
