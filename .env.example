# Copy to .env and adjust. Never commit .env.

# Ollama OpenAI-compatible API (default: local only)
ARGUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
ARGUS_LLM_API_KEY=ollama
ARGUS_MODEL=qwen3:4b

# Context window - keep small on limited VRAM / RAM hosts
ARGUS_NUM_CTX=4096

# SQLite path (created automatically)
ARGUS_DB_PATH=data/argus.db

# Single-user V0 identity (set your own values in .env)
ARGUS_USER_ID=owner
ARGUS_USER_ROLE=owner
ARGUS_DEVICE_ID=laptop_01

# Voice (optional). Requires: pip install -e ".[voice]"
# STT uses CPU by default so Ollama can keep the GPU.
ARGUS_VOICE_ENABLED=0
ARGUS_STT_MODEL=tiny
ARGUS_STT_DEVICE=cpu
